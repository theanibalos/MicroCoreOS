# ╔════════════════════════════════════════════════════════════════════════════╗
# ║  MicroCoreOS — every environment variable, with its default.               ║
# ║                                                                            ║
# ║  This file is the REFERENCE: commented options belong here.                ║
# ║  Your .env is STATE: only settings in effect, none commented out.          ║
# ║                                                                            ║
# ║  `microcoreos add <extra>` appends a section like these to your .env, so   ║
# ║  leaving a variable commented there makes it get appended a second time.   ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# ╭────────────────────────────────────────────────────────────────────────────╮
# │  HTTP SERVER                                            tools/http_server  │
# ╰────────────────────────────────────────────────────────────────────────────╯

HTTP_PORT=5000

# Bind address. Default: 127.0.0.1 (dev-safe).
# PRODUCTION / DOCKER: must be 0.0.0.0 or the service refuses external connections.
# HTTP_HOST=0.0.0.0

# CORS allowed origins. Default: * (dev-friendly).
# Production: your actual frontend domain(s), comma-separated.
# HTTP_CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Uvicorn log level. Default: warning. Set to info for HTTP access logs.
# HTTP_LOG_LEVEL=info

# ╭────────────────────────────────────────────────────────────────────────────╮
# │  DATABASE — SQLite                                           tools/sqlite  │
# ╰────────────────────────────────────────────────────────────────────────────╯

SQLITE_DB_PATH=database.db

# Migrations policy. Default: true (boot applies pending migrations).
# PRODUCTION: migrating from a replica is PROHIBITED — set false in EVERY
# replica. Migrations run ONLY as a CI/CD step, in a SINGLE instance, under
# explicit human supervision:
#   DB_AUTO_MIGRATE=true uv run main.py --boot-tool db
# DB_AUTO_MIGRATE=false

# ╭────────────────────────────────────────────────────────────────────────────╮
# │  EVENT BUS                                                tools/event_bus  │
# ╰────────────────────────────────────────────────────────────────────────────╯

# Driver. Default: in_process (same-process, zero infrastructure).
# Options: in_process | sqlite | redis_streams | kafka | rabbitmq
# The last two need `microcoreos add kafka` / `add rabbitmq` — see their sections.
# EVENT_BUS_DRIVER=in_process

# Dead-letter queue for events that exhausted their retries. Default: true.
# EVENT_BUS_DLQ_ENABLED=false

# --- sqlite driver: durable queue on disk, no broker ---
# EVENT_BUS_SQLITE_PATH=event_bus_queue.db
# EVENT_BUS_SQLITE_MAXLEN=10000        # rows kept per stream
# EVENT_BUS_SQLITE_POLL_MS=25          # consumer poll interval
# EVENT_BUS_SQLITE_SYNCHRONOUS=FULL    # FULL | NORMAL — NORMAL is faster, less durable

# --- redis_streams driver: also needs the REDIS section below ---
# EVENT_BUS_STREAM_MAXLEN=10000        # entries kept per stream
# EVENT_BUS_CLAIM_IDLE_MS=60000        # ms before a stalled message is reclaimed
# EVENT_BUS_DELAY_POLL_MS=500          # delayed-delivery poll interval

# ╭────────────────────────────────────────────────────────────────────────────╮
# │  TELEMETRY — OpenTelemetry                                tools/telemetry  │
# ╰────────────────────────────────────────────────────────────────────────────╯

# ALL tool calls get spans automatically via ToolProxy — no plugin changes.
# Install first:
#   uv add opentelemetry-sdk opentelemetry-exporter-otlp opentelemetry-instrumentation-fastapi
OTEL_ENABLED=false
OTEL_SERVICE_NAME=microcoreos

# Export destination. Commented = console exporter (dev).
# Jaeger, Grafana Tempo, or any OTLP/gRPC backend.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# BatchSpanProcessor tuning (OTel standard vars)
# OTEL_BSP_SCHEDULE_DELAY=5000         # ms between export batches
# OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512   # spans per batch
# OTEL_BSP_MAX_QUEUE_SIZE=2048         # in-memory buffer size

# ╭────────────────────────────────────────────────────────────────────────────╮
# │  HEALTH CHECK                                              domains/system  │
# ╰────────────────────────────────────────────────────────────────────────────╯

# ToolHealthPlugin calls db.health_check() periodically and updates the registry.
HEALTH_CHECK_INTERVAL=30

# ╭────────────────────────────────────────────────────────────────────────────╮
# │  METRICS                                                        always on  │
# ╰────────────────────────────────────────────────────────────────────────────╯

# Timing needs no config — ToolProxy measures every tool call:
#   records = self.registry.get_metrics()
#   self.registry.add_metrics_sink(callback)
# Each record: {tool, method, duration_ms, success, timestamp}

# ╭────────────────────────────────────────────────────────────────────────────╮
# │  AUTHENTICATION                                      microcoreos add auth  │
# ╰────────────────────────────────────────────────────────────────────────────╯

# AUTH_SECRET_KEY=change-me                # REQUIRED, 32 chars minimum
# AUTH_TOKEN_EXPIRE_MINUTES=60
# AUTH_ALGORITHM=HS256

# ╭────────────────────────────────────────────────────────────────────────────╮
# │  DATABASE — PostgreSQL                           microcoreos add postgres  │
# ╰────────────────────────────────────────────────────────────────────────────╯

# Replaces the sqlite tool: the LAST one to register wins the 'db' key.
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=postgres
# PG_PASSWORD=postgres
# PG_DATABASE=microcoreos
# PG_MIN_POOL=1
# PG_MAX_POOL=10
# PG_CONNECT_TIMEOUT=5
# PG_COMMAND_TIMEOUT=30

# ╭────────────────────────────────────────────────────────────────────────────╮
# │  REDIS                                              microcoreos add redis  │
# ╰────────────────────────────────────────────────────────────────────────────╯

# Swaps the in-memory state tool. For the Redis Streams EVENT BUS instead,
# set EVENT_BUS_DRIVER=redis_streams — that driver already ships in tools/event_bus/.
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=                          # empty for no auth
# REDIS_CONNECT_TIMEOUT=5

# ╭────────────────────────────────────────────────────────────────────────────╮
# │  S3 STORAGE                                            microcoreos add s3  │
# ╰────────────────────────────────────────────────────────────────────────────╯

# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_DEFAULT_REGION=us-east-1
# AWS_S3_ENDPOINT_URL=http://localhost:9000    # MinIO in dev; drop for real S3
# AWS_S3_DEFAULT_BUCKET=microcoreos-bucket
# AWS_S3_SIZE_LIMIT_ENABLED=true
# AWS_S3_MAX_FILE_SIZE_MB=10
# AWS_S3_VERIFY_SSL=true

# ╭────────────────────────────────────────────────────────────────────────────╮
# │  SCHEDULER                                      microcoreos add scheduler  │
# ╰────────────────────────────────────────────────────────────────────────────╯

# false on worker replicas: jobs register everywhere, fire in ONE beat replica.
# SCHEDULER_ENABLED=true

# ╭────────────────────────────────────────────────────────────────────────────╮
# │  KAFKA                                              microcoreos add kafka  │
# ╰────────────────────────────────────────────────────────────────────────────╯

# EVENT_BUS_DRIVER=kafka
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_BUS_TOPIC_PREFIX=bus.
# KAFKA_BUS_PARTITIONS=6
# KAFKA_BUS_REPLICATION=1
# KAFKA_CONNECT_TIMEOUT=5
# KAFKA_MAX_POLL_INTERVAL_MS=300000

# ╭────────────────────────────────────────────────────────────────────────────╮
# │  RABBITMQ                                        microcoreos add rabbitmq  │
# ╰────────────────────────────────────────────────────────────────────────────╯

# EVENT_BUS_DRIVER=rabbitmq
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_USER=guest
# RABBITMQ_PASSWORD=guest
# RABBITMQ_VHOST=/
# RABBITMQ_PREFETCH=16
# RABBITMQ_CONNECT_TIMEOUT=5

# ╭────────────────────────────────────────────────────────────────────────────╮
# │  CHAOS ENGINEERING                                  microcoreos add chaos  │
# ╰────────────────────────────────────────────────────────────────────────────╯

# Intentionally fails tools/plugins on boot to test fault tolerance.
# NEVER enable in production.
# CHAOS_ENABLED=true
